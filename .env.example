# ===== 感创项目流转平台 · 环境变量配置 =====
# 复制此文件为 .env，填入实际值

# 服务器端口（Railway 会自动设置 PORT，本地开发默认 3000）
PORT=3000

# MongoDB 连接字符串（可选，不填则使用本地 JSON 文件存储）
# 免费获取：https://www.mongodb.com/atlas → 创建免费集群 → Connect → Drivers
# 格式：mongodb+srv://<用户名>:<密码>@<集群地址>/<数据库名>?retryWrites=true&w=majority
MONGODB_URI=

# MongoDB 数据库名（默认 ganchuang）
MONGO_DB=ganchuang

# CORS 允许的前端域名（逗号分隔）
# Vercel 部署后，把 Vercel 域名加到这里
# 例如：https://ganchuang.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8080
